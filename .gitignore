# Ansible runtime cache (fact cache, retry files, tmp, .lock).
.ansible/

# Galaxy content installed by `task init` from requirements.yml.
# Reproducible — don't commit it.
collections/
roles/

# Local Claude Code agent state.
.claude/

# Staging dir for `task nix:check` (nixos/ + public_keys/ assembled
# into the layout the deploy produces under /etc/nixos). Transient.
.nix-stage/
