# Homelab inventory.
#
# The [init] group is for *first-run bootstrap only* — freshly installed
# Debian 13 boxes still on their DHCP lease. setup-debian.yml targets this
# group and configures static IP, hardening, Docker, Portainer Agent,
# Cockpit. After init, move the host out of [init] and into its role
# group below; its static IP/FQDN is what you put there.
#
# Role groups are addressed by their post-init static IP or FQDN.
# Each role has a matching setup-<role>.yml playbook and a `task
# deploy:<role>` entry. Role playbooks re-run the full baseline
# (init/basic/network/docker/portainer-agent/cockpit) and then layer
# the role-specific phase on top — idempotent, so re-runs are safe.

[init]
192.168.1.143

# Plain Docker hosts — baseline + Portainer Agent. No special hardware.
[docker]
# util1.andrsn.org

# GPU/LLM hosts — baseline + NVIDIA driver + nvidia-container-toolkit
# wired into Docker as the default runtime. Assumes PCI passthrough for
# the GPU is already configured at the Proxmox layer.
[gpu]
# llm1.andrsn.org

# Pterodactyl Wings hosts — baseline + Wings daemon. The node config
# (config.yml) is generated by the Pterodactyl panel and dropped onto
# the host out-of-band; Ansible only sets up the runtime + firewall.
[wings]
# wings1.andrsn.org
