# Homelab inventory.
#
# The [init] group is for *first-run bootstrap only* — freshly installed
# Debian 13 boxes still on their DHCP lease. setup-debian.yml targets this
# group and configures static IP, hardening, Docker, Portainer Agent,
# Cockpit. After init, move the host out of [init] and into its role
# group below; its static IP/FQDN is what you put there.
#
# Role groups are addressed by their post-init static IP or FQDN.
# Each role has a matching setup-<role>.yml playbook and a `task
# deploy:<role>` entry. Role playbooks re-run the full baseline
# (init/basic/network/docker/portainer-agent/cockpit) and then layer
# the role-specific phase on top — idempotent, so re-runs are safe.
#
# [nixos_wings] is the exception: those hosts run NixOS, where the
# baseline is declarative (nixos/modules/base.nix) and lands in the same
# switch as the role. See the comment on that group below.

[init]
# (empty — 192.168.1.143 finished bootstrap as util1 and moved to
# [jellyfin] at its static IP)

# Plain Docker hosts — baseline + Portainer Agent. No special hardware.
[docker]
# util1.andrsn.org

# GPU/LLM hosts — baseline + NVIDIA driver + nvidia-container-toolkit
# wired into Docker as the default runtime. Assumes PCI passthrough for
# the GPU is already configured at the Proxmox layer.
[gpu]
# llm1.andrsn.org

# Pterodactyl Wings hosts — NixOS, NOT Debian. These get no baseline
# chain: their whole configuration (admin user, ssh, docker, firewall,
# the wings daemon) is the flake under nixos/, and the phase
# (playbooks/nixos-wings.yml) just syncs it and runs nixos-rebuild.
#
# Each host needs host_vars/<ip>.yml naming its nixosConfigurations
# entry as `nixos_host`. Lifecycle: install NixOS from the ISO, run
# scripts/nixos-bootstrap.sh as root, paste its hardware config into
# nixos/hosts/<name>/, then `task deploy:nixos-wings`.
[nixos_wings]
# 192.168.1.60  # wings1 — nixos_host in host_vars/192.168.1.60.yml

# Pterodactyl Panel host — baseline + the panel/MariaDB/Redis stack.
# The control plane only; game servers live on the [nixos_wings] hosts.
# util1 is in this group AND [jellyfin]: both role deploys are
# idempotent and their phases don't overlap.
[pterodactyl]
192.168.1.50  # util1 — identity/network vars in host_vars/192.168.1.50.yml

# Jellyfin media hosts — baseline + the custom Jellyfin container
# (frob/cuddlefish) with media served read-only from /srv/media. Set
# jellyfin_enable_gpu in group_vars/jellyfin.yml for NVIDIA transcoding.
[jellyfin]
192.168.1.50  # util1 — identity/network vars in host_vars/192.168.1.50.yml
