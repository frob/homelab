## Pterodactyl Wings as a NixOS module.
##
## nixpkgs ships no Pterodactyl anything — no pterodactyl-wings in
## pkgs/by-name, no services.pterodactyl.* in module-list.nix on 25.05
## or unstable — so both the package and the unit are ours. The package
## lives in ../pkgs/wings.nix so the flake can expose it as a buildable
## output; this file is just the service.
##
## The node's own config (/etc/pterodactyl/config.yml) is NOT managed
## here. It's generated by the panel when you create the node and
## carries that node's secret token; it is pulled onto the host once
## with `wings configure`. The unit is gated on its existence so a
## freshly converged node sits inert instead of crash-looping.
{ config, lib, pkgs, ... }:

let
  cfg = config.homelab.wings;
  wings = pkgs.callPackage ../pkgs/wings.nix { };
in
{
  options.homelab.wings = {
    enable = lib.mkEnableOption "the Pterodactyl Wings daemon";

    apiPort = lib.mkOption {
      type = lib.types.port;
      default = 8080;
      description = "Port the panel reaches this node's API on.";
    };

    sftpPort = lib.mkOption {
      type = lib.types.port;
      default = 2022;
      description = "Port Wings' built-in SFTP server listens on.";
    };

    gamePortRanges = lib.mkOption {
      type = with lib.types; listOf (attrsOf port);
      default = [{ from = 25500; to = 25600; }];
      example = [{ from = 25500; to = 25600; } { from = 27000; to = 27050; }];
      description = ''
        Port ranges opened for the game servers themselves, TCP and UDP.

        This is the one Wings has no opinion about and the one you hit
        first: the panel will happily allocate a Minecraft server port
        27015, and it is simply unreachable until that port is in a
        range here. Keep it aligned with the allocations you create in
        the panel for this node.
      '';
    };

    dataDir = lib.mkOption {
      type = lib.types.path;
      default = "/var/lib/pterodactyl";
      description = ''
        Wings' root directory — game server volumes, backups and
        install logs all live under here. This is the directory that
        needs the disk, and the one worth putting on its own volume.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    environment.systemPackages = [ wings ];

    systemd.tmpfiles.rules = [
      # 0700: config.yml holds the node's panel token.
      "d /etc/pterodactyl 0700 root root -"
      "d ${cfg.dataDir} 0700 root root -"
      "d ${cfg.dataDir}/volumes 0700 root root -"
      "d /var/log/pterodactyl 0700 root root -"
    ];

    systemd.services.wings = {
      description = "Pterodactyl Wings Daemon";
      after = [ "docker.service" "network-online.target" ];
      requires = [ "docker.service" ];
      wants = [ "network-online.target" ];
      partOf = [ "docker.service" ];
      wantedBy = [ "multi-user.target" ];

      # The whole point of this gate. Wings exits immediately without a
      # config.yml, and the config can only come from the panel after
      # the node exists there — so on a brand-new node the unit would
      # otherwise burn its restart budget and leave a red systemctl
      # status that says nothing useful. With the condition, a node
      # awaiting `wings configure` reports exactly that, and starts on
      # its own the next boot after the file lands.
      unitConfig = {
        ConditionPathExists = "/etc/pterodactyl/config.yml";
        # [Unit], not [Service]: systemd moved the rate-limit settings
        # there, and nixpkgs warns (then systemd ignores it) if you put
        # StartLimitInterval under serviceConfig.
        StartLimitIntervalSec = 600;
      };

      serviceConfig = {
        User = "root";
        WorkingDirectory = "/etc/pterodactyl";
        ExecStart = "${wings}/bin/wings --config /etc/pterodactyl/config.yml";
        Restart = "on-failure";
        RestartSec = 5;
        # Wings holds a descriptor per game server connection plus the
        # SFTP sessions; the upstream unit's 4096 is the floor.
        LimitNOFILE = 4096;
      };
    };

    networking.firewall = {
      enable = true;
      allowedTCPPorts = [ cfg.apiPort cfg.sftpPort ];
      allowedTCPPortRanges = cfg.gamePortRanges;
      allowedUDPPortRanges = cfg.gamePortRanges;
    };
  };
}
